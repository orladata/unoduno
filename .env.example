# ============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# 
# Copy this file to .env.local for development:
#   cp .env.example .env.local
#
# SECURITY NOTES:
# - Never commit .env.local or any file containing real secrets
# - Variables with NEXT_PUBLIC_ prefix are exposed to the browser
# - Use strong, unique values for all secrets (min 32 characters)
# - Rotate secrets regularly, especially if compromised
#
# ============================================================================

# -----------------------------------------------------------------------------
# Server-Only Variables (Never exposed to client)
# -----------------------------------------------------------------------------

# Node environment (development | production | test)
NODE_ENV=development

# Session encryption secret (REQUIRED in production)
# Generate with: openssl rand -hex 32
SESSION_SECRET=your-session-secret-min-32-chars-here

# CSRF protection secret (REQUIRED in production)
# Generate with: openssl rand -hex 32
CSRF_SECRET=your-csrf-secret-min-32-chars-here

# Database connection string (REQUIRED in production)
# Example: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL=

# Redis connection for distributed rate limiting (optional, recommended for production)
# Example: redis://user:password@host:6379
REDIS_URL=

# Google Gemini API key (REQUIRED for video analysis and AI features)
# Get from: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=AIzaSyDfBNzdyMAZ6rHbbaMzVKqRB-itcfZ9Rcs

# YouTube Data API key (optional)
# Get from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Stripe secret key (optional, for payments)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=

# Stripe webhook secret (optional, for payment webhooks)
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# Email service API key (optional)
EMAIL_API_KEY=

# -----------------------------------------------------------------------------
# Public Variables (Exposed to browser - use sparingly)
# -----------------------------------------------------------------------------

# Public site URL (used for SEO and social sharing)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe publishable key (safe to expose)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Analytics ID (safe to expose)
NEXT_PUBLIC_ANALYTICS_ID=

# Modal.com Configuration (REQUIRED for YouTube processing)
# Deploy do worker: modal deploy scripts/modal_audio_extractor.py
# Copie a URL retornada pelo deployment e cole aqui
MODAL_WORKER_URL=https://seu-account--unoduno-audio-extractor.modal.run

# Modal Account Name (optional, for logging)
MODAL_ACCOUNT_NAME=seu-account

# ============================================================================
# Bright Data Proxy Configuration (OPTIONAL - for bypassing YouTube bot detection)
# ============================================================================
# 
# Bright Data fornece proxy residencial que contorna bloqueios de bot detection
# do YouTube ao fazer download de áudio. Aumenta taxa de sucesso de 70-80% → 95%+
#
# Setup:
# 1. Criar conta em: https://www.brightdata.com/
# 2. Criar zona com acesso a proxy residencial
# 3. Copiar credenciais abaixo
#
# Docs: https://docs.brightdata.com/general/tutorials/getting-started
# ============================================================================

# Chave API Bright Data (encontrada em Dashboard → Settings → API)
# Nunca compartilhe esta chave publicamente
BRIGHT_DATA_API_KEY=

# Username Bright Data (encontrado em Dashboard → Settings → API)
BRIGHT_DATA_USERNAME=

# Nome da zona Bright Data criada para YouTube scraping
# Exemplo: "youtube-zone", "unoduno-zone", etc
BRIGHT_DATA_ZONE=

# Porta do proxy Bright Data (normalmente 22225 para HTTPS)
# Pode variar: 22225 (HTTPS), 22226 (SOCKS5), 33125 (HTTP)
BRIGHT_DATA_PROXY_PORT=22225
